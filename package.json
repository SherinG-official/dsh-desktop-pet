{
  "name": "dsh-session-board",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "会话进程看板：自动识别 等你回答 / 工作中 / 闲置 / 结束，点一下直接进入对话。带鲸蓝娘皮肤。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "pet",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node tests/model.test.js && node tests/store.test.js && node tests/routes.test.js && node tests/pet.test.js && node tests/skins.test.js && node tests/memory.test.js",
    "test:node": "node --test tests/"
  },
  "dsh": {
    "displayName": "会话进程",
    "description": "自动识别会话进程（等你回答 / 工作中 / 闲置 / 结束），点一下直接进入对话。",
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
